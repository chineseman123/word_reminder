<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera preview (full screen) -->
    <TextureView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Teleprompter text overlay - positioned at top area near camera -->
    <ScrollView
        android:id="@+id/teleprompterScroll"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_gravity="top"
        android:layout_marginTop="48dp"
        android:background="#00000000"
        android:scrollbars="none"
        android:overScrollMode="never">

        <TextView
            android:id="@+id/teleprompterText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="80dp"
            android:textColor="#FFFFFFCC"
            android:textSize="22sp"
            android:lineSpacingMultiplier="1.6"
            android:fontFamily="sans-serif"
            android:shadowColor="#FF000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3" />

    </ScrollView>

    <!-- Top bar: controls -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="36dp"
        android:paddingBottom="8dp"
        android:background="#80000000">

        <!-- Edit button -->
        <ImageButton
            android:id="@+id/btnEdit"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_edit"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="编辑文案"
            android:tint="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Font size down -->
        <ImageButton
            android:id="@+id/btnFontDown"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_font_down"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="缩小字体"
            android:tint="#FFFFFF" />

        <!-- Font size indicator -->
        <TextView
            android:id="@+id/txtFont"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="22"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:minWidth="24dp"
            android:gravity="center" />

        <!-- Font size up -->
        <ImageButton
            android:id="@+id/btnFontUp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_font_up"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="放大字体"
            android:tint="#FFFFFF" />

        <!-- Opacity down -->
        <ImageButton
            android:id="@+id/btnOpacityDown"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="降低透明度"
            android:tint="#FFFFFF" />

        <!-- Opacity up -->
        <ImageButton
            android:id="@+id/btnOpacityUp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_forward"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="提高透明度"
            android:tint="#FFFFFF" />

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="4dp"
            android:background="#40FFFFFF" />

        <!-- Zoom out -->
        <ImageButton
            android:id="@+id/btnZoomOut"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_font_down"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="缩小焦距"
            android:tint="#FFFFFF" />

        <!-- Zoom indicator -->
        <TextView
            android:id="@+id/txtZoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.0x"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:minWidth="26dp"
            android:gravity="center" />

        <!-- Zoom in -->
        <ImageButton
            android:id="@+id/btnZoomIn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_font_up"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="放大焦距"
            android:tint="#FFFFFF" />

        <!-- Collapse top bar -->
        <ImageButton
            android:id="@+id/btnCollapseTop"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="2dp"
            android:src="@drawable/ic_arrow_up"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="收起功能栏"
            android:tint="#FFFFFF" />

    </LinearLayout>

    <!-- 功能栏收起后浮在右上角，点一下重新展开 -->
    <ImageButton
        android:id="@+id/btnExpandTop"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="6dp"
        android:src="@drawable/ic_arrow_down"
        android:background="#80000000"
        android:contentDescription="展开功能栏"
        android:tint="#FFFFFF"
        android:visibility="gone" />

    <!-- Bottom bar: record + scroll control -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingBottom="20dp"
        android:background="#80000000">

        <!-- Scroll speed control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="速度"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekSpeed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="20"
                android:progress="3"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <!-- 当前速度档位 -->
            <TextView
                android:id="@+id/txtSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3/20"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:minWidth="38dp"
                android:gravity="center" />

            <!-- Play/Pause scroll -->
            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_forward"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="播放/暂停滚动"
                android:tint="#FFFFFF" />

            <!-- Reset scroll -->
            <ImageButton
                android:id="@+id/btnReset"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_reset"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="回到顶部"
                android:tint="#FFFFFF" />

        </LinearLayout>

        <!-- Subtitle background shade control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="背景"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekBg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="25"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <TextView
                android:id="@+id/txtBg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25%"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:minWidth="38dp"
                android:gravity="center" />

        </LinearLayout>

        <!-- 美颜：美白（识别人脸后只美白脸部，识别不到则全局提亮） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="美白"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekWhiten"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <TextView
                android:id="@+id/txtWhiten"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:minWidth="38dp"
                android:gravity="center" />

        </LinearLayout>

        <!-- 美颜：磨皮（祛痘/黑头淡化，仅作用于人脸区域，不糊背景） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="磨皮"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekSmooth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <TextView
                android:id="@+id/txtSmooth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:minWidth="38dp"
                android:gravity="center" />

        </LinearLayout>

        <!-- Record button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="8dp">

            <ImageButton
                android:id="@+id/btnRecord"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_record"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="开始录制"
                android:scaleType="fitCenter"
                android:padding="4dp" />

            <!-- Recording timer -->
            <TextView
                android:id="@+id/txtTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="00:00"
                android:textColor="#FFFF0000"
                android:textSize="18sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- Edit panel (hidden by default) -->
    <LinearLayout
        android:id="@+id/editPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FF1A1A2E"
        android:visibility="gone"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="编辑提词内容"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/editText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FF16213E"
            android:gravity="top|start"
            android:hint="在此粘贴或输入提词内容..."
            android:textColorHint="#FFFFFF80"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="12dp"
            android:inputType="textMultiLine|textLongMessage"
            android:scrollbars="vertical"
            android:overScrollMode="always" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnHistoryEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="历史"
                android:backgroundTint="#FF333355"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnSpeechTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="语音测试"
                android:backgroundTint="#FF333355"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnCancelEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="取消"
                android:backgroundTint="#FF333355"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnConfirmEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="确认"
                android:backgroundTint="#FF0F3460"
                android:textColor="#FFFFFF"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>